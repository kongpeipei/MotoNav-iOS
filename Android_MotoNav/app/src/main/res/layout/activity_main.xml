<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 地图显示在上方（占满剩余空间） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.motonav.app.ui.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 右下角：缩放按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="14dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnZoomIn"
                android:layout_width="46dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_locate"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:contentDescription="放大" />

            <Button
                android:id="@+id/btnZoomOut"
                android:layout_width="46dp"
                android:layout_height="40dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_locate"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:contentDescription="缩小" />
        </LinearLayout>

        <!-- 右上角：天气+明日天气 + ⋯菜单 + 加油站按钮（竖排） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:padding="6dp"
                    android:background="#80000000"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⋯"
                    android:textSize="20sp"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTomorrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:padding="5dp"
                android:background="#80000000"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnGas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛽"
                android:textSize="16sp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:layout_marginTop="6dp"
                android:contentDescription="显示市区加油站" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部控制区：状态 + 历史 + 去这里 + 搜索框 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 状态条（半透明，叠加信息提醒） -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#66000000"
            android:padding="6dp"
            android:text="@string/status_waiting"
            android:textColor="@color/textPrimary"
            android:textSize="13sp"
            android:maxLines="2" />

        <!-- 类别搜索结果（学校/医院/加油站，横向可滚动，点击直接规划路线） -->
        <HorizontalScrollView
            android:id="@+id/categoryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/categoryChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <!-- 历史搜索记录（横向可滚动标签） -->
        <HorizontalScrollView
            android:id="@+id/historyRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/historyChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <!-- 搜索预览"去这里"按钮（搜索后显示） -->
        <Button
            android:id="@+id/btnGoHere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="2dp"
            android:text="去这里（规划路线）"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_gohere"
            android:visibility="gone" />

        <!-- 导航中的退出按钮（覆盖搜索行） -->
        <Button
            android:id="@+id/btnExitNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="2dp"
            android:text="退出导航"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_exitnav"
            android:visibility="gone" />

        <!-- 搜索框行（导航时被退出导航按钮替代） -->
        <LinearLayout
            android:id="@+id/searchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 定位按钮：搜索框上侧偏右 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:paddingEnd="10dp">

                <Button
                    android:id="@+id/btnLocate"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_locate"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="◎"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:contentDescription="定位到当前位置" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <AutoCompleteTextView
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_search"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:completionThreshold="1" />

                <!-- 一键清除输入内容（有内容时显示） -->
                <TextView
                    android:id="@+id/btnClear"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    android:contentDescription="清除输入" />

                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_search"
                    android:minWidth="0dp"
                    android:minHeight="40dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
